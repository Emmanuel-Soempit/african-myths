<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrfToken }}">

  <title inertia>AdonisJS x Inertia x React</title>

  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i"
    rel="stylesheet" />

  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

  <style>
    :root {
      --sand-1: #fdfdfc;
      --sand-2: #f9f9f8;
      --sand-3: #f1f0ef;
      --sand-4: #e9e8e6;
      --sand-5: #e2e1de;
      --sand-6: #dad9d6;
      --sand-7: #cfceca;
      --sand-8: #bcbbb5;
      --sand-9: #8d8d86;
      --sand-10: #82827c;
      --sand-11: #63635e;
      --sand-12: #21201c;
    }
  </style>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            "display": ["Newsreader", "serif"]
          },
          borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
          colors: {
            // primary brand, matches --color-primary
            primary: {
              DEFAULT: '#19e619',
            },

            // mapped to your CSS variables
            green: {
              DEFAULT: '#19e619',  // --color-green-light / primary
              gray: '#293829',     // --color-green-gray / surface-dark
              dark: '#111811',     // --color-green-dark / background-dark
              light: '#112111'
            },

            brown: {
              DEFAULT: '#a09982',  // --color-brown-light
              gray: '#817457',     // --color-brown-gray
              dark: '#402f17',     // --color-brown-dark

            },

            "text-primary-dark": "#ffffff",
            "text-secondary-dark": "#9db89d",
            "background-light": "#f6f8f6",
            "background-dark": "#111811",
            "surface-dark": "#293829",

            sand: {
              1: 'var(--sand-1)',
              2: 'var(--sand-2)',
              3: 'var(--sand-3)',
              4: 'var(--sand-4)',
              5: 'var(--sand-5)',
              6: 'var(--sand-6)',
              7: 'var(--sand-7)',
              8: 'var(--sand-8)',
              9: 'var(--sand-9)',   // fixed typo
              10: 'var(--sand-10)',
              11: 'var(--sand-11)',
              12: 'var(--sand-12)',
            },
          },
          spacing: {
            'page-x': 'var(--space-page-x)',
            'page-x-sm': 'var(--space-page-x-sm)',
            'page-x-lg': 'var(--space-page-x-lg)',
            'section-gap-sm': 'var(--space-section-gap-sm)',
            'section-gap-md': 'var(--space-section-gap-md)',
            'section-gap-lg': 'var(--space-section-gap-lg)',
            'card-gap': 'var(--space-card-gap)',
            'card-gap-lg': 'var(--space-card-gap-lg)',
            'hero-top': 'var(--space-hero-top)',
            'hero-pad': 'var(--space-hero-padding)',
            'input-sm': 'var(--input-height-sm)',
            'input-md': 'var(--input-height-md)',
            'input-lg': 'var(--input-height-lg)',
          },
          borderRadius: {
            md: 'var(--radius-md)',
            xl: 'var(--radius-lg)',
            full: 'var(--radius-full)',
          },
          fontSize: {
            'hero-sm': ['var(--text-hero-sm)', { lineHeight: '1.1' }],
            'hero-lg': ['var(--text-hero-lg)', { lineHeight: '1.1' }],
            'section-title': ['var(--text-section-title)', { lineHeight: '1.2' }],
            title: ['var(--text-title)', { lineHeight: '1.3' }],
            body: ['var(--text-body)', { lineHeight: '1.5' }],
            'body-lg': ['var(--text-body-lg)', { lineHeight: '1.5' }],
            'body-sm': ['var(--text-body-sm)', { lineHeight: '1.5' }],
            caption: ['var(--text-caption)', { lineHeight: '1.4' }],
          },
        },
      },
    }
  </script>

  @stack('dumper')
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>

<body class="min-h-screen w-screen font-display">
  @inertia()
</body>

</html>